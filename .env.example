# Copie para apps/api/.env (backend) e apps/web/.env.local (frontend) conforme necessário.

# --- Banco de dados ---
DATABASE_URL="postgresql://leilao:leilao@localhost:5432/leilao_erp?schema=public"

# --- Redis / Filas ---
REDIS_URL="redis://localhost:6379"

# --- Storage (MinIO em dev, S3 em produção) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="leilao-erp-dev"
STORAGE_ACCESS_KEY="leilao"
STORAGE_SECRET_KEY="leilao12345"
STORAGE_FORCE_PATH_STYLE="true"

# --- Autenticação ---
JWT_ACCESS_SECRET="troque-este-valor-em-producao-access"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque-este-valor-em-producao-refresh"
JWT_REFRESH_EXPIRES_IN_DAYS="30"
# Cookies de sessão (access_token/refresh_token/XSRF-TOKEN) — "true" exige HTTPS,
# use "false" em dev local sobre http://localhost.
COOKIE_SECURE="false"
# Opcional: só necessário se API e frontend estiverem em subdomínios diferentes
# do mesmo domínio (ex.: api.empresa.com / app.empresa.com → COOKIE_DOMAIN=".empresa.com").
COOKIE_DOMAIN=
# Exigida para criar uma empresa nova em /setup/nova-empresa (POST /companies/register).
# Troque em produção e não divulgue — é a única barreira dessa tela pública.
COMPANY_SETUP_KEY="troque-esta-chave-em-producao"

# --- API ---
API_PORT=3001
CORS_ORIGIN="http://localhost:3002"

# --- Frontend ---
NEXT_PUBLIC_API_URL="http://localhost:3001"

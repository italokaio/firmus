{
  "name": "leilao-erp",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @leilao-erp/api prisma:generate",
    "db:migrate": "pnpm --filter @leilao-erp/api prisma:migrate",
    "db:seed": "pnpm --filter @leilao-erp/api prisma:seed",
    "db:studio": "pnpm --filter @leilao-erp/api prisma:studio"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  }
}
